// כללי האבטחה של Firestore. מדביקים ב-Firebase Console → Firestore Database → Rules → Publish.
// משתמשים נכנסים כאורח (Anonymous) ומקלידים מייל; המנהל נכנס עם Google.
// המנהל לפי UID של חשבון ה-Google שלו (Authentication → Users). גם ב-ADMIN_UIDS ב-app/index.html.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in ['4EJ0sat6LNforqh8IFux6UAr23r1']; }
    function blocked() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    // משתמשים: כל אחד רואה ומעדכן רק את עצמו (בלי אפשרות לבטל חסימה), המנהל רואה את כולם וחוסם
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && !('blocked' in request.resource.data);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked', 'first']));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);   // כל אחד יכול למחוק את עצמו
    }

    // מיילים חסומים: כל מחובר יכול לבדוק מייל מסוים (לא לקבל רשימה), רק המנהל משנה
    match /blockedEmails/{email} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // תקלות מהטלפונים: כל מחובר יכול לדווח (רק להוסיף, בגודל סביר), רק המנהל קורא ומוחק
    match /errors/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['msg', 'where', 't', 'version', 'email', 'ua', 'standalone'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300;
      allow read, delete: if isAdmin();
    }

    // רשימה משותפת: רק למחוברים שלא נחסמו (מי שיודע את קוד הרשימה)
    match /lists/{code}/items/{item} {
      allow read, write: if signedIn() && !blocked();
    }
  }
}
